-- a. Calculate total revenue for each product. (2 marks) 
select
    productname,
    sum(quantity * unitprice) as total_revenue
from sales
group by productname;




-- b. Calculate monthly revenue and month-over-month revenue change using a window function. (2 marks) 
select
    sale_year,
    sale_month,
    monthly_revenue,
    monthly_revenue - lag(monthly_revenue) over (
        order by sale_year, sale_month
    ) as revenue_change
from monthly_sales
order by sale_year, sale_month;


